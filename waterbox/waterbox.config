{
  "coreName": "Pokket",
  "systemId": "POCKETSTATION",
  "systemNames": {
    "POCKETSTATION": "Sony PocketStation"
  },
  "author": "Darien Liu (mentalfoundry)",
  "url": "https://github.com/mentalfoundry/Pokket",
  "runsOn": [ "windows-x86_64", "linux-x86_64", "macos-x86_64", "windows-aarch64", "linux-aarch64", "macos-aarch64" ],
  "romFile": "rom",
  "deterministic": true,
  "memoryLayoutMiB": [
    4,
    4,
    4,
    4,
    8
  ],
  "_memoryLayoutMiB_note": "sbrk, sealed, invisible, plain, mmap. The whole machine (Pokket's psemu_t) is about 355 KiB and lands on the mmap heap; the card file is read through it once at Init.",
  "video": {
    "_comment": "The screen is 32 by 32 pixels at one bit each. The virtual size is the same square, larger, so the window shows it at a usable size.",
    "width": 32,
    "height": 32,
    "virtualWidth": 256,
    "virtualHeight": 256,
    "vsyncNumerator": 32,
    "vsyncDenominator": 1,
    "_vsync_note": "One frame is a 32nd of a second, 33000 of Pokket's reference cycles, as Pokket's own libretro core runs it: the screen refreshes at about 32 Hz.",
    "getBgra": "GetVideoBgra"
  },
  "audio": {
    "_comment": "The machine has a DAC that software writes directly; Pokket resamples it to 8000 Hz mono, 250 samples a frame.",
    "rate": 8000,
    "samplesPerFrame": 1024,
    "channels": 1,
    "get": "GetAudio"
  },
  "lag": {
    "inputWasRead": "InputWasRead"
  },
  "extensions": {
    ".mcd": "POCKETSTATION",
    ".mcr": "POCKETSTATION",
    ".mc": "POCKETSTATION",
    ".mem": "POCKETSTATION",
    ".gme": "POCKETSTATION",
    ".mcs": "POCKETSTATION",
    ".pss": "POCKETSTATION"
  },
  "input": {
    "name": "PocketStation",
    "_comment": "The five buttons on the front, then the reset button behind the case. The order is the wire format.",
    "buttons": [
      "Up",
      "Right",
      "Down",
      "Left",
      "Action",
      "Reset"
    ],
    "players": [
      [ "Up", "Right", "Down", "Left", "Action" ]
    ],
    "mnemonics": {
      "Up": "U",
      "Right": "R",
      "Down": "D",
      "Left": "L",
      "Action": "A",
      "Reset": "r"
    }
  },
  "settings": [
    {
      "name": "hardwareId",
      "display": "setting.hardware_id",
      "type": "string",
      "default": "410000D3",
      "description": "setting.hardware_id.about"
    }
  ],
  "firmware": [
    {
      "id": "pocketstation.bin",
      "display": "firmware.bios",
      "description": "firmware.bios.about",
      "size": 16384,
      "name": "pocketstation.bin",
      "nameHints": [ "pocketstation", "pocket" ]
    }
  ]
}
